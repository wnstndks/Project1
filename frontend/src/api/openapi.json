          "market_value_krw",
          "cost_basis",
          "unrealized_pnl",
          "unrealized_pct",
          "realized_pnl",
          "total_pnl",
          "usd_krw",
          "allocation",
          "holdings_count"
        ],
        "title": "SummaryOut",
        "description": "All amounts in USD unless suffixed with _krw."
      },
      "TransactionIn": {
        "properties": {
          "asset_type": {
            "$ref": "#/components/schemas/AssetType"
          },
          "symbol": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Symbol",
            "examples": [
              "AAPL",
              "BTC"
            ]
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          },
          "trade_date": {
            "type": "string",
            "format": "date",
            "title": "Trade Date"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Price",
            "description": "USD per unit"
          },
          "fee": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Fee",
            "default": "0"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "asset_type",
          "symbol",
          "side",
          "trade_date",
          "quantity",
          "price"
        ],
        "title": "TransactionIn"
      },
      "TransactionOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "asset_type": {
            "$ref": "#/components/schemas/AssetType"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          },
          "trade_date": {
            "type": "string",
            "format": "date",
            "title": "Trade Date"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "fee": {
            "type": "number",
            "title": "Fee"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "asset_type",
          "symbol",
          "side",
          "trade_date",
          "quantity",
          "price",
          "fee",
          "note",
          "created_at"
        ],
        "title": "TransactionOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
