            "type": "number",
            "title": "Market Value"
          },
          "market_value_krw": {
            "type": "number",
            "title": "Market Value Krw"
          },
          "cost_basis": {
            "type": "number",
            "title": "Cost Basis"
          },
          "cost_basis_krw": {
            "type": "number",
            "title": "Cost Basis Krw"
          }
        },
        "type": "object",
        "required": [
          "date",
          "market_value",
          "market_value_krw",
          "cost_basis",
          "cost_basis_krw"
        ],
        "title": "HistoryPointOut"
      },
      "HoldingOut": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "asset_type": {
            "$ref": "#/components/schemas/AssetType"
          },
          "quantity": {
            "type": "number",
            "title": "Quantity"
          },
          "avg_cost": {
            "type": "number",
            "title": "Avg Cost"
          },
          "cost_basis": {
            "type": "number",
            "title": "Cost Basis"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "price_as_of": {
            "type": "string",
            "format": "date-time",
            "title": "Price As Of"
          },
          "market_value": {
            "type": "number",
            "title": "Market Value"
          },
          "unrealized_pnl": {
            "type": "number",
            "title": "Unrealized Pnl"
          },
          "unrealized_pct": {
            "type": "number",
            "title": "Unrealized Pct"
          },
          "realized_pnl": {
            "type": "number",
            "title": "Realized Pnl"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "name",
          "asset_type",
          "quantity",
          "avg_cost",
          "cost_basis",
          "price",
          "price_as_of",
          "market_value",
          "unrealized_pnl",
          "unrealized_pct",
          "realized_pnl",
          "weight"
        ],
        "title": "HoldingOut"
      },
      "QuoteOut": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "price",
          "as_of"
        ],
        "title": "QuoteOut"
      },
      "Side": {
        "type": "string",
        "enum": [
          "buy",
          "sell"
        ],
        "title": "Side"
      },
      "SummaryOut": {
        "properties": {
          "market_value": {
            "type": "number",
            "title": "Market Value"
          },
          "market_value_krw": {
            "type": "number",
            "title": "Market Value Krw"
          },
          "cost_basis": {
            "type": "number",
            "title": "Cost Basis"
          },
          "unrealized_pnl": {
            "type": "number",
            "title": "Unrealized Pnl"
          },
          "unrealized_pct": {
            "type": "number",
            "title": "Unrealized Pct"
          },
          "realized_pnl": {
            "type": "number",
            "title": "Realized Pnl"
          },
          "total_pnl": {
            "type": "number",
            "title": "Total Pnl"
          },
          "usd_krw": {
            "type": "number",
            "title": "Usd Krw"
          },
          "allocation": {
            "items": {
              "$ref": "#/components/schemas/AllocationOut"
            },
            "type": "array",
            "title": "Allocation"
          },
          "holdings_count": {
            "type": "integer",
