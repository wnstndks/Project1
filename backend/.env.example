# Copy to .env and fill in. Never commit .env.

# Screenshot import (Claude API). Alternatively set ANTHROPIC_API_KEY or run `ant auth login`.
AM_ANTHROPIC_API_KEY=
# Model used to read screenshots (default claude-opus-5-5; claude-haiku-5-5 is cheaper)
# AM_IMPORT_MODEL=claude-opus-5-5

# News (https://finnhub.io, free tier)
AM_FINNHUB_API_KEY=

# Well-known investor holdings. SEC EDGAR requires a declared User-Agent in the form
# "app-name contact-email" (https://www.sec.gov/os/accessing-edgar-data); empty skips 13F
# investors, ARK ETF holdings work without it.
AM_SEC_USER_AGENT=
# Optional OpenFIGI key (https://www.openfigi.com/api): raises the CUSIP->ticker rate limit
AM_OPENFIGI_API_KEY=

# US House members' trade disclosures (STOCK Act PTRs from the Clerk's site, no key needed).
# Batches of 60 PDFs one background sync works through back to back before stopping.
# AM_CONGRESS_MAX_BATCHES=10

# Real orders. Keep false: until you switch it on yourself, strategies only write paper-trading
# records. Only the exact words true/false are accepted.
AM_LIVE_TRADING=false

# --- Deployment and access control (docs/dev/DECISIONS.md D-035) ---
# Local development needs none of these: the defaults are development, no login, no demo.
#
# "production" sends security headers (HSTS, CSP, nosniff, no framing), marks the session
# cookie Secure, turns /docs off, and refuses to start unless the instance is either a
# read-only demo (AM_DEMO_MODE) or has a login (hash + secret below).
# AM_ENV=development
#
# Public read-only demo: every write under /api answers 403 except compute-only routes, and
# ticker routes only answer for the demo ledger's own symbols. Cannot run with real orders.
# AM_DEMO_MODE=false
#
# Single-account login. Create the hash yourself (it asks for the password twice and prints
# one line; the password is stored nowhere):
#   py -m uv run python -m app.security.hash_password
# Keep the value in single quotes so nothing expands its $ signs. Empty = no login.
# Format: scrypt$<n>$<r>$<p>$<salt_b64>$<hash_b64>
# Set a login on any PC that also runs the public demo container, even for local use: a
# container that was broken into can reach this PC's localhost ports (Docker Desktop's
# host.docker.internal), and without a login nothing stops it from reading or changing the
# real ledger. The Host allow-list does not help there; it only stops browsers.
AM_AUTH_PASSWORD_HASH=
# Signs session cookies; at least 32 bytes of randomness, e.g. the output of
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it (or the password hash) logs every browser out.
AM_SESSION_SECRET=
# How long a login lasts, in hours
# AM_SESSION_TTL_HOURS=168
# Wrong passwords one address may send within the window before it gets 429
# AM_LOGIN_MAX_ATTEMPTS=5
# AM_LOGIN_WINDOW_MINUTES=15
#
# /api requests one address may send per minute (0 = no limit; a public demo should set one)
# AM_RATE_LIMIT_PER_MINUTE=0
# Header to read the client address from. Set it only when every request reaches the app
# through that proxy (CF-Connecting-IP behind Cloudflare Tunnel); empty uses the socket peer.
# AM_CLIENT_IP_HEADER=
# Host names the server answers to, and browser origins allowed to call /api cross-origin
# (JSON lists). Behind a tunnel, list the public host name here.
# AM_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# AM_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
# Folder with the built frontend (index.html + assets) for the server to serve; unset in
# development, where Vite serves the frontend.
# AM_STATIC_DIR=
# Content-Security-Policy header sent in production. Empty keeps the built-in default
# (same-origin scripts and API only; see app/security/policy.py).
# AM_CONTENT_SECURITY_POLICY=

# Risk limits (docs/dev/DECISIONS.md D-002). Ratios of equity.
# Max drawdown can only be tightened (0 < x <= 0.20).
# AM_RISK_MAX_DRAWDOWN=0.20
# AM_RISK_DAILY_LOSS_LIMIT=0.03
# AM_RISK_MAX_ORDER_FRACTION=0.05
# Optional absolute cap per buy order, in KRW (the smaller of the two caps applies)
# AM_RISK_MAX_ORDER_KRW=
# AM_RISK_MAX_POSITION_WEIGHT=0.20
# Broad index funds (SPY) instead of the cap above (D-025); can only be tightened (0 < x <= 0.80)
# AM_RISK_MAX_INDEX_FUND_WEIGHT=0.80
# Asset class budgets of the registered strategy (STRATEGIES.md S1), at most 1 together
# AM_STRATEGY_BUDGET_STOCK=0.80
# AM_STRATEGY_BUDGET_CRYPTO=0.20
# Virtual starting capital of the paper account (KRW), unrelated to real holdings
# AM_PAPER_INITIAL_CAPITAL_KRW=10000000

# Buy-more / stop-loss rule checks (DECISIONS.md D-027). The user's rules, not signals.
# Percent of the average cost (trailing stop: of the recent high); days are final bars.
# AM_RULES_CUT_LOSS_PCT=15
# AM_RULES_TRAILING_LOOKBACK_DAYS=60
# AM_RULES_TRAILING_DROP_PCT=20
# AM_RULES_BELOW_MA_DAYS=5
# AM_RULES_MA_LONG=60
# AM_RULES_MA_SHORT=20
# Two steps of 5% keep every add price above the 15% stop-loss.
# AM_RULES_ADD_STEP_PCT=5
# AM_RULES_ADD_MAX_STEPS=2
# AM_RULES_ADD_REQUIRES_ABOVE_MA_SHORT=true
# AM_RULES_TARGET_WEIGHT_GAP_PT=5
# Coins move several times as much as stocks; empty falls back to the global value.
# AM_RULES_CRYPTO_CUT_LOSS_PCT=25
# AM_RULES_CRYPTO_TRAILING_DROP_PCT=30
# AM_RULES_CRYPTO_ADD_STEP_PCT=8
# Loss at the stop-loss price as a share of total assets above which the check warns
# AM_RULES_MAX_RISK_PCT=2.0

# Portfolio coach defaults until a policy is saved (DECISIONS.md D-033); not trading limits.
# Coins together as % of equity, and the loss if every stop-loss fired as % of total assets.
# AM_COACH_MAX_CRYPTO_WEIGHT_PCT=30
# AM_COACH_MAX_TOTAL_RISK_PCT=8
