# Copy to .env and fill in. Never commit .env.

# Screenshot import (Claude API). Alternatively set ANTHROPIC_API_KEY or run `ant auth login`.
AM_ANTHROPIC_API_KEY=
# Model used to read screenshots (default claude-opus-5-5; claude-haiku-5-5 is cheaper)
# AM_IMPORT_MODEL=claude-opus-5-5

# News (https://finnhub.io, free tier)
AM_FINNHUB_API_KEY=

# Well-known investor holdings. SEC EDGAR requires a declared User-Agent in the form
# "app-name contact-email" (https://www.sec.gov/os/accessing-edgar-data); empty skips 13F
# investors, ARK ETF holdings work without it.
AM_SEC_USER_AGENT=
# Optional OpenFIGI key (https://www.openfigi.com/api): raises the CUSIP->ticker rate limit
AM_OPENFIGI_API_KEY=

# US House members' trade disclosures (STOCK Act PTRs from the Clerk's site, no key needed).
# Batches of 60 PDFs one background sync works through back to back before stopping.
# AM_CONGRESS_MAX_BATCHES=10

# Real orders. Keep false: until you switch it on yourself, strategies only write paper-trading
# records. Only the exact words true/false are accepted.
AM_LIVE_TRADING=false

# Risk limits (docs/dev/DECISIONS.md D-002). Ratios of equity.
# Max drawdown can only be tightened (0 < x <= 0.20).
# AM_RISK_MAX_DRAWDOWN=0.20
# AM_RISK_DAILY_LOSS_LIMIT=0.03
# AM_RISK_MAX_ORDER_FRACTION=0.05
# Optional absolute cap per buy order, in KRW (the smaller of the two caps applies)
# AM_RISK_MAX_ORDER_KRW=
# AM_RISK_MAX_POSITION_WEIGHT=0.20
# Broad index funds (SPY) instead of the cap above (D-025); can only be tightened (0 < x <= 0.80)
# AM_RISK_MAX_INDEX_FUND_WEIGHT=0.80
# Asset class budgets of the registered strategy (STRATEGIES.md S1), at most 1 together
# AM_STRATEGY_BUDGET_STOCK=0.80
# AM_STRATEGY_BUDGET_CRYPTO=0.20
# Virtual starting capital of the paper account (KRW), unrelated to real holdings
# AM_PAPER_INITIAL_CAPITAL_KRW=10000000

# Buy-more / stop-loss rule checks (DECISIONS.md D-027). The user's rules, not signals.
# Percent of the average cost (trailing stop: of the recent high); days are final bars.
# AM_RULES_CUT_LOSS_PCT=15
# AM_RULES_TRAILING_LOOKBACK_DAYS=60
# AM_RULES_TRAILING_DROP_PCT=20
# AM_RULES_BELOW_MA_DAYS=5
# AM_RULES_MA_LONG=60
# AM_RULES_MA_SHORT=20
# Two steps of 5% keep every add price above the 15% stop-loss.
# AM_RULES_ADD_STEP_PCT=5
# AM_RULES_ADD_MAX_STEPS=2
# AM_RULES_ADD_REQUIRES_ABOVE_MA_SHORT=true
# AM_RULES_TARGET_WEIGHT_GAP_PT=5
# Coins move several times as much as stocks; empty falls back to the global value.
# AM_RULES_CRYPTO_CUT_LOSS_PCT=25
# AM_RULES_CRYPTO_TRAILING_DROP_PCT=30
# AM_RULES_CRYPTO_ADD_STEP_PCT=8
# Loss at the stop-loss price as a share of total assets above which the check warns
# AM_RULES_MAX_RISK_PCT=2.0
